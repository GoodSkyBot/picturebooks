<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Picture Books</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@700&display=swap" rel="stylesheet">
    <style>
      :root {
        color-scheme: light;
        --ink: #223126;
        --muted: #5a684f;
        --paper: #fffdf4;
        --sun: #ffd766;
        --sky: #8fd3ff;
        --leaf: #6fbd61;
        --berry: #e9566b;
        --line: #d7cfae;
        font-family: Arial, sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background:
          linear-gradient(180deg, rgba(143, 211, 255, 0.28), rgba(255, 253, 244, 0) 260px),
          #f6f1df;
        color: var(--ink);
      }

      main {
        width: min(1120px, 100%);
        margin: 0 auto;
        padding: 36px max(20px, env(safe-area-inset-left)) 72px;
      }

      .hero {
        display: grid;
        gap: 14px;
        margin-bottom: 24px;
      }

      h1 {
        margin: 0;
        font-family: "Baloo 2", cursive;
        font-size: clamp(2.4rem, 8vw, 4.7rem);
        line-height: 0.95;
        font-weight: 700;
        letter-spacing: 0;
      }

      .intro {
        max-width: 42rem;
        line-height: 1.45;
        font-size: clamp(1.08rem, 2vw, 1.24rem);
        margin: 0;
      }

      .mode-tabs {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr)) 76px;
        gap: 12px;
        margin: 28px 0 18px;
      }

      button,
      input {
        font: inherit;
      }

      .mode-tab,
      .search-toggle,
      .clear-button,
      .subject-button {
        min-height: 64px;
        border: 3px solid var(--ink);
        border-radius: 18px;
        background: var(--paper);
        color: var(--ink);
        cursor: pointer;
        box-shadow: 0 5px 0 rgba(34, 49, 38, 0.18);
      }

      .mode-tab {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 14px 18px;
        font-family: "Baloo 2", cursive;
        font-size: clamp(1.2rem, 4vw, 1.65rem);
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
      }

      .search-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        background: #ffffff;
      }

      .mode-tab[aria-selected="true"] {
        background: var(--sun);
      }

      .mode-tab:focus-visible,
      .search-toggle:focus-visible,
      .clear-button:focus-visible,
      .subject-button:focus-visible,
      .book-card:focus-visible,
      .field-control:focus-visible {
        outline: 4px solid #1d7ed0;
        outline-offset: 4px;
      }

      .mode-tab:active,
      .search-toggle:active,
      .clear-button:active,
      .subject-button:active,
      .book-card:active {
        transform: translateY(3px);
        box-shadow: 0 2px 0 rgba(34, 49, 38, 0.18);
      }

      .panel {
        margin-top: 18px;
      }

      [hidden] {
        display: none !important;
      }

      .search-icon {
        width: 30px;
        height: 30px;
      }

      .search-panel {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 14px;
        align-items: end;
        margin-bottom: 22px;
      }

      .field {
        display: grid;
        gap: 7px;
      }

      .field-label {
        font-family: "Baloo 2", cursive;
        font-size: 1.05rem;
      }

      .field-control {
        width: 100%;
        min-height: 64px;
        border: 3px solid var(--line);
        border-radius: 16px;
        background: #ffffff;
        color: var(--ink);
        font-size: 1.12rem;
        padding: 0 18px;
      }

      .clear-button {
        padding: 0 22px;
        font-family: "Baloo 2", cursive;
        font-size: 1.08rem;
        background: #ffffff;
      }

      .empty-state {
        color: var(--muted);
        line-height: 1.45;
      }

      .subject-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 16px;
        margin-bottom: 22px;
      }

      .subject-button {
        display: grid;
        justify-items: center;
        gap: 10px;
        min-height: 190px;
        padding: 18px 14px;
        background: #ffffff;
      }

      .subject-button[aria-pressed="true"] {
        background: #fff0b6;
        border-color: #c75b12;
      }

      .subject-icon {
        width: 112px;
        height: 112px;
        object-fit: contain;
      }

      .subject-name {
        font-family: "Baloo 2", cursive;
        font-size: 1.4rem;
        line-height: 1.05;
      }

      .subject-count {
        color: var(--muted);
        font-size: 1rem;
      }

      .books {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 22px;
      }

      .book-card {
        display: block;
        min-height: 100%;
        border-radius: 18px;
        background: #ffffff;
        color: inherit;
        text-decoration: none;
        border: 3px solid #ffffff;
        border-bottom: 8px solid var(--accent);
        overflow: hidden;
        box-shadow: 0 10px 24px rgba(36, 45, 32, 0.12);
        transition: transform 0.18s ease, box-shadow 0.18s ease;
      }

      .book-card:hover,
      .book-card:focus-visible {
        transform: translateY(-4px);
        box-shadow: 0 14px 28px rgba(36, 45, 32, 0.18);
      }

      .book-card img {
        display: block;
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        background: #eadfbd;
      }

      .book-info {
        padding: 18px 20px 22px;
      }

      .book-category {
        display: inline-flex;
        align-items: center;
        min-height: 30px;
        margin-bottom: 10px;
        border-radius: 999px;
        background: color-mix(in srgb, var(--accent) 18%, #ffffff);
        color: var(--ink);
        padding: 4px 12px;
        font-size: 0.92rem;
        font-weight: 700;
      }

      .book-title {
        margin: 0 0 7px;
        font-family: "Baloo 2", cursive;
        font-size: 1.45rem;
        line-height: 1.05;
        font-weight: 700;
      }

      .book-subtitle {
        margin: 0;
        font-size: 1rem;
        color: var(--muted);
        line-height: 1.35;
      }

      .empty-state {
        margin: 20px 0 0;
        border: 3px dashed var(--line);
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.7);
        padding: 24px;
        font-size: 1.1rem;
      }

      .icon-tab {
        width: 28px;
        height: 28px;
        flex-shrink: 0;
      }

      @media (max-width: 760px) {
        main {
          padding-top: 24px;
        }

        .search-panel {
          grid-template-columns: 1fr;
        }

        .mode-tabs {
          position: sticky;
          top: 0;
          z-index: 2;
          background: rgba(246, 241, 223, 0.94);
          padding: 10px 0;
        }
      }

      @media (max-width: 480px) {
        main {
          padding-left: max(14px, env(safe-area-inset-left));
          padding-right: max(14px, env(safe-area-inset-right));
        }

        .books {
          grid-template-columns: 1fr;
        }

        .mode-tabs {
          grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 68px;
          gap: 8px;
        }

        .mode-tab {
          padding-left: 10px;
          padding-right: 10px;
          font-size: 1.1rem;
          gap: 6px;
        }

        .mode-tab .icon-tab {
          width: 22px;
          height: 22px;
        }

        .subject-grid {
          grid-auto-flow: column;
          grid-auto-columns: minmax(150px, 42vw);
          grid-template-columns: none;
          overflow-x: auto;
          overscroll-behavior-x: contain;
          padding-bottom: 12px;
          scroll-snap-type: x proximity;
        }

        .subject-button {
          min-height: 170px;
          padding: 14px 8px;
          scroll-snap-align: start;
        }

        .subject-icon {
          width: 88px;
          height: 88px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .book-card,
        .mode-tab,
        .search-toggle,
        .clear-button,
        .subject-button {
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <section class="hero" aria-labelledby="library-title">
        <h1 id="library-title">Picture Books</h1>
        <p class="intro">Pick a book from the shelf, or choose a subject to find a favorite topic.</p>
      </section>

      <div class="mode-tabs" role="tablist" aria-label="Library browsing modes">
        <button class="mode-tab" id="all-mode-tab" type="button" role="tab" aria-selected="true" aria-controls="all-books-panel" data-mode="all"><svg class="icon-tab" viewBox="0 0 28 28" aria-hidden="true"><rect x="3" y="3" width="9" height="9" rx="2" fill="none" stroke="#223126" stroke-width="3"/><rect x="16" y="3" width="9" height="9" rx="2" fill="none" stroke="#223126" stroke-width="3"/><rect x="3" y="16" width="9" height="9" rx="2" fill="none" stroke="#223126" stroke-width="3"/><rect x="16" y="16" width="9" height="9" rx="2" fill="none" stroke="#223126" stroke-width="3"/></svg>All Books</button>
        <button class="mode-tab" id="subjects-mode-tab" type="button" role="tab" aria-selected="false" aria-controls="subjects-panel" data-mode="subjects"><svg class="icon-tab" viewBox="0 0 28 28" aria-hidden="true"><path d="M3 5a2 2 0 012-2h7.6a2 2 0 011.4.6l10.4 10.4a2 2 0 010 2.8l-7.6 7.6a2 2 0 01-2.8 0L3.6 14A2 2 0 013 12.6V5z" fill="none" stroke="#223126" stroke-width="2.5" stroke-linejoin="round"/><circle cx="8.5" cy="8.5" r="1.5" fill="#223126"/></svg>Subjects</button>
        <button class="search-toggle" id="search-toggle" type="button" aria-label="Search books" aria-expanded="false" aria-controls="search-panel">
          <svg class="search-icon" viewBox="0 0 32 32" aria-hidden="true">
            <circle cx="14" cy="14" r="9" fill="#ffffff" stroke="#223126" stroke-width="4"/>
            <path d="M21 21l7 7" stroke="#223126" stroke-width="4" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

      <div class="search-panel" id="search-panel" aria-label="Book search" hidden>
        <label class="field" for="search-input">
          <span class="field-label">Find a book</span>
          <input class="field-control" id="search-input" type="search" placeholder="Try frogs or fossils" autocomplete="off">
        </label>
        <button class="clear-button" id="clear-filters" type="button">Show all</button>
      </div>

      <section class="panel" id="all-books-panel" role="tabpanel" aria-labelledby="all-mode-tab">
      </section>

      <section class="panel" id="subjects-panel" role="tabpanel" aria-labelledby="subjects-mode-tab" hidden>
        <div class="subject-grid" aria-label="Subjects">
          {% for category in categories %}
          <button class="subject-button" type="button" data-subject="{{ category.slug }}" aria-pressed="false">
            <img class="subject-icon" src="/icons/{{ category.icon_key }}.svg" alt="" width="112" height="112">
            <span class="subject-name">{{ category.label }}</span>
            <span class="subject-count">{{ category.count }} book{% if category.count != 1 %}s{% endif %}</span>
          </button>
          {% endfor %}
        </div>
      </section>

      <ul class="books" id="books-list">
        {% for book in books %}
        <li data-book data-category="{{ book.category_slug }}" data-search="{{ book.search_terms }}">
          <a class="book-card" href="/books/{{ book.slug }}/" style="--accent: {{ book.primary_color }}">
            <img src="/books/{{ book.slug }}/{{ book.cover_image }}"
                 alt="{{ book.cover_alt }}"
                 loading="lazy">
            <div class="book-info">
              <span class="book-category">{{ book.category }}</span>
              <p class="book-title">{{ book.title }}</p>
              <p class="book-subtitle">{{ book.subtitle }}</p>
            </div>
          </a>
        </li>
        {% endfor %}
      </ul>
      <p class="empty-state" id="empty-state" hidden>No books found. Try another word or subject.</p>
    </main>

    <script>
      document.documentElement.classList.add("js");

      const modeTabs = Array.from(document.querySelectorAll("[data-mode]"));
      const allPanel = document.querySelector("#all-books-panel");
      const subjectsPanel = document.querySelector("#subjects-panel");
      const searchToggle = document.querySelector("#search-toggle");
      const searchPanel = document.querySelector("#search-panel");
      const searchInput = document.querySelector("#search-input");
      const clearButton = document.querySelector("#clear-filters");
      const subjectButtons = Array.from(document.querySelectorAll("[data-subject]"));
      const bookItems = Array.from(document.querySelectorAll("[data-book]"));
      const emptyState = document.querySelector("#empty-state");

      let mode = "all";
      let selectedSubject = "all";

      function updateMode(nextMode) {
        mode = nextMode;
        if (mode === "all") {
          selectedSubject = "all";
        }
        modeTabs.forEach((tab) => {
          const isSelected = tab.dataset.mode === mode;
          tab.setAttribute("aria-selected", String(isSelected));
        });
        allPanel.hidden = mode !== "all";
        subjectsPanel.hidden = mode !== "subjects";
        applyFilters();
      }

      function setSearchOpen(isOpen) {
        searchPanel.hidden = !isOpen;
        searchToggle.setAttribute("aria-expanded", String(isOpen));
        if (isOpen) {
          searchInput.focus();
        }
      }

      function applyFilters() {
        const query = searchInput.value.trim().toLowerCase();
        const subject = mode === "subjects" ? selectedSubject : "all";
        let visibleCount = 0;

        bookItems.forEach((item) => {
          const matchesSubject = subject === "all" || item.dataset.category === subject;
          const matchesSearch = !query || item.dataset.search.includes(query);
          const isVisible = matchesSubject && matchesSearch;
          item.hidden = !isVisible;
          if (isVisible) {
            visibleCount += 1;
          }
        });

        subjectButtons.forEach((button) => {
          button.setAttribute("aria-pressed", String(subject !== "all" && button.dataset.subject === subject));
        });

        emptyState.hidden = visibleCount !== 0;
      }

      modeTabs.forEach((tab) => {
        tab.addEventListener("click", () => updateMode(tab.dataset.mode));
      });

      searchToggle.addEventListener("click", () => {
        if (searchPanel.hidden) {
          setSearchOpen(true);
        } else {
          searchInput.value = "";
          setSearchOpen(false);
          applyFilters();
        }
      });

      subjectButtons.forEach((button) => {
        button.addEventListener("click", () => {
          selectedSubject = button.dataset.subject;
          searchInput.value = "";
          applyFilters();
        });
      });

      searchInput.addEventListener("input", applyFilters);
      clearButton.addEventListener("click", () => {
        searchInput.value = "";
        selectedSubject = "all";
        setSearchOpen(false);
        applyFilters();
      });

      applyFilters();
    </script>
  </body>
</html>
