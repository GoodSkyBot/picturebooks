    <!-- Page {{ page_number }}: 2 images, layout B (text left, images stacked right) -->
    <article class="page page--content page--layout-2b" data-page="{{ page_number }}" hidden>
      <div class="page-body">
        <p class="page-text">{{ page.text }}</p>
        {% if page.extras %}
        <div class="extras">
          {% for extra in page.extras %}
          <button class="extra" data-audio="audio/page-{{ '%02d' % page_number }}-extra-{{ loop.index }}.mp3" aria-label="Fun fact: {{ extra }}">
            <span class="extra-icon" aria-hidden="true">*</span> {{ extra }}
          </button>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      <div class="page-images-pair">
        {% for img in page.images %}
        <figure class="page-figure">
          <img src="{{ img.src }}" alt="{{ img.alt }}"{% if img.fit or img.position %} style="{% if img.fit %}object-fit: {{ img.fit }};{% endif %}{% if img.position %}{% if img.fit %} {% endif %}object-position: {{ img.position }};{% endif %}"{% endif %}>
          {% if img.caption %}
          <figcaption>{{ img.caption }}</figcaption>
          {% endif %}
        </figure>
        {% endfor %}
      </div>
      <button class="btn-read" data-audio="audio/page-{{ '%02d' % page_number }}-text.mp3" aria-label="Read this page aloud">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0014 8.5v7a4.49 4.49 0 002.5-3.5zM14 3.23v2.06a6.51 6.51 0 010 13.42v2.06A8.51 8.51 0 0014 3.23z"/></svg>
      </button>
    </article>
