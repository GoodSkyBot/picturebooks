    <!-- Cover -->
    <article class="page page--cover" data-page="0">
      <div class="cover-image-wrap">
        <img src="{{ cover.image }}" alt="{{ cover.title }}">
      </div>
      <div class="cover-text">
        <h1 class="cover-title">{{ cover.title }}</h1>
        {% if cover.subtitle %}
        <p class="cover-subtitle">{{ cover.subtitle }}</p>
        {% endif %}
      </div>
      <div class="cover-actions">
        <button class="btn-icon btn-fullscreen" aria-label="Fullscreen" id="btn-fullscreen">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 00-2 2v3m18 0V5a2 2 0 00-2-2h-3m0 18h3a2 2 0 002-2v-3M3 16v3a2 2 0 002 2h3"/></svg>
        </button>
        <button class="btn-icon btn-print" aria-label="Print" onclick="window.print()">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
        </button>
      </div>
    </article>
