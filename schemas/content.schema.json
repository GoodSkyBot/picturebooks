{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://picturebooks.local/schemas/content.schema.json",
  "title": "Picture Book Research Content",
  "type": "object",
  "required": [
    "topic",
    "slug",
    "targetAge",
    "sources",
    "facts",
    "images"
  ],
  "additionalProperties": false,
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "targetAge": {
      "type": "integer",
      "minimum": 3,
      "maximum": 8
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url", "accessed"],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accessed": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["category", "text", "source"],
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "filename",
          "description",
          "source_url",
          "author",
          "license",
          "license_url"
        ],
        "additionalProperties": false,
        "properties": {
          "filename": {
            "type": "string",
            "minLength": 1,
            "pattern": "^images/.+"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "license_url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
