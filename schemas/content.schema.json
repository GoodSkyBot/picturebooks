{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://picturebooks.local/schemas/content.schema.json",
  "title": "Picture Book Research Dossier",
  "type": "object",
  "required": [
    "topic",
    "slug",
    "targetAge",
    "sources",
    "researchNotes",
    "images"
  ],
  "additionalProperties": false,
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "targetAge": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url", "accessed"],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accessed": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "researchNotes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "text", "sources"],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Short label for this research note, used to help the author scan the dossier."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "A sourced research note. Prefer connected explanation over isolated atomic facts."
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueItems": true
          },
          "relatedImages": {
            "type": "array",
            "description": "Optional image filenames that may support this note.",
            "items": {
              "type": "string",
              "pattern": "^images/.+"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "handoffNotes": {
      "type": "string",
      "description": "Optional freeform context for the author, such as research gaps, cautions, promising angles, or source limitations."
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "filename",
          "description",
          "source_url",
          "author",
          "license",
          "license_url",
          "width",
          "height",
          "contentTags"
        ],
        "additionalProperties": false,
        "properties": {
          "filename": {
            "type": "string",
            "minLength": 1,
            "pattern": "^images/.+"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "license_url": {
            "type": "string",
            "format": "uri"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "imageType": {
            "type": "string",
            "enum": [
              "photo",
              "illustration",
              "painting",
              "diagram",
              "map",
              "document",
              "other"
            ]
          },
          "styleTags": {
            "type": "array",
            "description": "Optional visual style descriptors useful for choosing a consistent image set.",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "contentTags": {
            "type": "array",
            "description": "What the image shows or could support in the book, such as lifecycle, habitat, movement, close-up, place, person, tool, map, or cover.",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
