{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://picturebooks.local/schemas/book.schema.json",
  "title": "Picture Book Authoring Output",
  "type": "object",
  "required": [
    "title",
    "slug",
    "targetAge",
    "textScale",
    "category",
    "tags",
    "theme",
    "cover",
    "pages",
    "backMatter"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "targetAge": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99
    },
    "textScale": {
      "type": "string",
      "enum": ["large", "standard", "compact"],
      "description": "Book-wide body text profile. Use large for sparse read-aloud books, standard for typical early readers, and compact for denser independent-reader books."
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "description": "Kid-facing homepage subject label. Reuse existing subjects when they fit."
    },
    "tags": {
      "type": "array",
      "description": "Hidden search terms for the homepage library search.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "theme": {
      "type": "object",
      "required": [
        "primaryColor",
        "secondaryColor",
        "backgroundColor",
        "accentColor",
        "fontHeading",
        "fontBody",
        "vibe"
      ],
      "additionalProperties": false,
      "properties": {
        "primaryColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "secondaryColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "backgroundColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "accentColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "fontHeading": {
          "type": "string",
          "minLength": 1
        },
        "fontBody": {
          "type": "string",
          "minLength": 1
        },
        "vibe": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cover": {
      "type": "object",
      "required": ["title", "image"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "image": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "narration": {
      "type": "object",
      "description": "Optional audio narration preferences. If omitted, the build script picks a stable automatic voice for this book.",
      "additionalProperties": false,
      "properties": {
        "voice": {
          "type": "string",
          "enum": ["auto", "alloy", "ash", "ballad", "coral", "echo", "fable", "nova", "onyx", "sage", "shimmer", "verse", "marin", "cedar"],
          "description": "Narration voice. Use auto for a stable per-book voice chosen from the model's supported voices."
        },
        "speed": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 4.0,
          "description": "Narration speed. Values below 1.0 are slower; values above 1.0 are faster."
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "description": "Tone instructions for gpt-4o-mini-tts narration."
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "images"],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "extras": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 4
          },
          "images": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["src", "alt"],
              "additionalProperties": false,
              "properties": {
                "src": {
                  "type": "string",
                  "minLength": 1
                },
                "alt": {
                  "type": "string",
                  "minLength": 1
                },
                "fit": {
                  "type": "string",
                  "enum": ["cover", "contain", "scale-down"],
                  "description": "CSS object-fit value. Use contain for maps/documents, cover (default) for photos."
                },
                "position": {
                  "type": "string",
                  "enum": ["center", "top", "bottom", "left", "right"],
                  "description": "CSS object-position value. Use top for portraits to avoid clipping heads."
                },
                "orientation": {
                  "type": "string",
                  "enum": ["landscape", "portrait", "square"],
                  "description": "Image aspect ratio class. Used by the build system to select appropriate page layouts."
                }
              }
            }
          }
        }
      }
    },
    "backMatter": {
      "type": "object",
      "required": ["showCredits", "showSources"],
      "additionalProperties": false,
      "properties": {
        "showCredits": {
          "type": "boolean"
        },
        "showSources": {
          "type": "boolean"
        }
      }
    }
  }
}
